# App
NEXT_PUBLIC_APP_NAME="Orynth ProductLab"

# OpenAI
OPENAI_API_KEY=

# Database
DATABASE_URL=
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Queue / cache
REDIS_URL=

# Integrations
GITHUB_TOKEN=
X_API_BEARER_TOKEN=
HELIUS_API_KEY=
# Optional RPC override. Without HELIUS_API_KEY, chain ingestion falls back to
# public mainnet, which throttles getTokenLargestAccounts hard — usable for
# development, not for a real sweep.
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com
ORYNTH_API_KEY=
ORYNTH_API_BASE_URL=https://api.orynth.example

# Wallet / signing (worker process only — never expose to the web tier)
POOL_CREATOR_SIGNER_KEY=
LAUNCHER_SIGNER_KEY=
KMS_KEY_ID=

# API auth
# Required as `Authorization: Bearer <token>` on the scoring, snapshot, and job
# routes. These cost money (OpenAI) and write to the database, so they return
# 503 until this is set.
API_TOKEN=

# Signing guardrails
# Shared secret required as `Authorization: Bearer <token>` on POST /api/enqueue-signing.
# The endpoint returns 503 until this is set.
SIGNING_API_TOKEN=
# Comma-separated base58 program IDs the signer is permitted to co-sign for.
# Empty means deny-all: no transaction will be signed.
SIGNING_ALLOWED_PROGRAM_IDS=

# Scheduler (worker process)
# Master switch. Off by default — a scheduler that starts itself would hit
# external APIs the first time anyone ran a worker.
SCHEDULER_ENABLED=false
# Cron for the ingestion sweep (fans out one ingest job per tracked launch).
SCHEDULER_INGEST_CRON=0 */6 * * *
# Cron for the scoring sweep. No default: scoring calls OpenAI per launch, so
# it stays off until you opt in by setting an expression here.
SCHEDULER_SCORE_CRON=
SCHEDULER_TIMEZONE=UTC
