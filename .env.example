# App
NEXT_PUBLIC_APP_NAME="Orynth ProductLab"

# OpenAI
OPENAI_API_KEY=

# Database
DATABASE_URL=
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Queue / cache
REDIS_URL=

# Integrations
GITHUB_TOKEN=
X_API_BEARER_TOKEN=
HELIUS_API_KEY=
ORYNTH_API_KEY=
ORYNTH_API_BASE_URL=https://api.orynth.example

# Wallet / signing (worker process only — never expose to the web tier)
POOL_CREATOR_SIGNER_KEY=
LAUNCHER_SIGNER_KEY=
KMS_KEY_ID=

# API auth
# Required as `Authorization: Bearer <token>` on the scoring, snapshot, and job
# routes. These cost money (OpenAI) and write to the database, so they return
# 503 until this is set.
API_TOKEN=

# Signing guardrails
# Shared secret required as `Authorization: Bearer <token>` on POST /api/enqueue-signing.
# The endpoint returns 503 until this is set.
SIGNING_API_TOKEN=
# Comma-separated base58 program IDs the signer is permitted to co-sign for.
# Empty means deny-all: no transaction will be signed.
SIGNING_ALLOWED_PROGRAM_IDS=
